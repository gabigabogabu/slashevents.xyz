# Generate two different values with: openssl rand -hex 32
# Use URL-safe characters for POSTGRES_PASSWORD (hex avoids URL escaping).
POSTGRES_PASSWORD=
SLASHEVENTS_API_TOKEN=

PUBLIC_URL=http://localhost:3000
BIND_ADDRESS=127.0.0.1
PORT=3000
SLASHEVENTS_IMAGE=ghcr.io/gabigabogabu/slashevents:0.2.0

# Comma-separated proxy IPs/CIDRs. Empty means ignore forwarded headers.
TRUSTED_PROXY_CIDRS=
# Requests per minute; 0 disables an individual limit.
RPC_RATE_LIMIT_PER_MINUTE=120
INGRESS_RATE_LIMIT_PER_MINUTE=120
PUBLIC_RATE_LIMIT_PER_MINUTE=60
AUTH_FAILURE_RATE_LIMIT_PER_MINUTE=20
MAX_REQUEST_BODY_BYTES=1048576
RETENTION_INTERVAL_SECONDS=60

# Direct container runs / source development only; Compose constructs this itself.
# DATABASE_URL=postgres://slashevents:password@localhost:5432/slashevents
# TEST_DB_URL=postgres://slashevents:password@localhost:5432/slashevents_test
