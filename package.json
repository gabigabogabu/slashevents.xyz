{
  "name": "slashevents",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch --no-clear-screen src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint --fix \"src/**/*.ts\"",
    "test": "bun test ./src",
    "test:dev": "bun --watch --no-clear-screen test ./src",
    "test:smoke": "bun scripts/smoke.ts"
  },
  "dependencies": {
    "lodash": "^4.17.21",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@types/bun": "latest",
    "@types/lodash": "^4.17.20",
    "@types/node": "^25.9.3",
    "eslint": "^10.5.0",
    "eslint-plugin-import": "^2.32.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gabigabogabu/slashevents.xyz.git"
  },
  "packageManager": "bun@1.3.14"
}
